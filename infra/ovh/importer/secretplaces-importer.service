[Unit]
Description=Secret Places place import (OSM + Wikidata/Commons enrichment)
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/opt/secretplaces-importer
Environment=SP_DB=local
Environment=SP_STATE=/opt/secretplaces-importer/state.json
Environment=SP_CITIES_PER_RUN=8
Environment=SP_RECENT_DAYS=2
Environment=SP_MIN_AGE_DAYS=7
Environment=SP_PREFER_EXTRACT=1
Environment=SP_OVERPASS_ROUNDS=2
ExecStart=/opt/secretplaces-importer/venv/bin/python -u /opt/secretplaces-importer/autopilot.py
# Shared host (client sites): stay in the background.
Nice=15
IOSchedulingClass=idle
CPUQuota=50%
MemoryMax=512M
TimeoutStartSec=4h
