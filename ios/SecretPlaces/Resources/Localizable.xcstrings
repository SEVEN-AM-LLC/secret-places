    "This permanently deletes your account, saves, visits and unlock records. This cannot be undone.": {
      "extractionState": "manual",
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це назавжди видалить акаунт, збережене, відвідане та записи розблокувань. Дію неможливо скасувати."
          }
        }
      }
    },
    "Restored. Your unlocks are up to date.": {
      "extractionState": "manual",
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відновлено. Ваші розблокування актуальні."
          }
        }
      }
    },
