# ---- iOS (baked into Core/Config.swift; anon key is publishable/safe) ----
SUPABASE_URL=https://api.secretplaces.7am.digital
SUPABASE_ANON_KEY=<publishable anon key>

# ---- Edge Function: verify-purchase (set as Supabase function secrets) ----
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are provided by Supabase automatically.
APPLE_BUNDLE_ID=com.secretplaces.app
APPLE_APP_ID=                      # App Store Connect → App Information → Apple ID (numeric; required for Production)
APPLE_ROOT_CERTS=                  # base64 DER of AppleRootCA-G3.cer (comma-separate to add more)
# Production AND Sandbox (TestFlight / App Review) are both accepted by default.
# APPLE_ALLOW_SANDBOX=false        # optional: reject Sandbox transactions
# APPLE_VERIFY=dev                 # LOCAL ONLY: skips signature checks — never set in production
